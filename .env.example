# ─────────────────────────────────────────────────────────────────────────────
# Safar With Zakia — environment configuration. Copy to .env (development) or to
# your host's secret store (production). Never commit real values.
# The server validates these at start-up (src/server/env.ts) and names anything missing.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public origin of the site, used for links in emails, auth and SEO (required)
APP_URL="http://localhost:3000"

# Session/signing secret, at least 32 characters (required). Generate: openssl rand -base64 48
# Also derives the key that encrypts the stored Gmail token — rotating it requires reconnecting Gmail.
AUTH_SECRET=""

# Bearer secret for the scheduled email worker endpoint /api/cron/email-outbox (24+ chars).
# Leave empty to disable that endpoint (e.g. when running `npm run worker:email` instead).
EMAIL_WORKER_SECRET=""

# Where enquiry notifications go if no address is set in Admin → Email delivery.
ENQUIRY_RECIPIENT_EMAIL=""

# ── Gmail API (OAuth 2.0). See docs/DEPLOYMENT.md "Gmail API". ──────────────
# OAuth client from Google Cloud Console (type: Web application)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# Must exactly match an "Authorized redirect URI" on that OAuth client
GMAIL_REDIRECT_URI="http://localhost:3000/api/admin/gmail/callback"
# Optional alternative to connecting through the admin: a refresh token for the sending
# mailbox (scope gmail.send) plus that mailbox's address. A mailbox connected in the admin wins.
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_ADDRESS=""

# ── Optional ─────────────────────────────────────────────────────────────────
# "true" (default) when behind a proxy that sets X-Forwarded-For (Vercel, Render, nginx, Caddy).
# Set "false" if the app is exposed directly, so clients cannot spoof their IP.
TRUST_PROXY_HEADERS="true"
# Public form limits (defaults: 5 per IP per 10 minutes, 5 per email per hour)
# ENQUIRY_RATE_LIMIT_PER_IP=5
# ENQUIRY_RATE_LIMIT_PER_EMAIL=5

# Docker Compose only (docker-compose.yml)
# POSTGRES_USER=safar
# POSTGRES_PASSWORD=
# POSTGRES_DB=safar

# Automated tests only — never set in production (loopback URLs only):
# TEST_GOOGLE_OAUTH_BASE_URL=
# TEST_GMAIL_API_BASE_URL=
